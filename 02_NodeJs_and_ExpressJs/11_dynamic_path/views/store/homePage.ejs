<%- include("../partials/head") %>
</head>
<body class="bg-white dark:bg-zinc-900 text-black dark:text-white min-h-screen">

    <%- include("../partials/nav") %>

    <!-- Main Content - with responsive padding and width -->
    <div class="pt-20 px-4 sm:px-6 lg:px-8 flex items-center justify-center min-h-[calc(100vh-80px)]">
        <div class="w-full max-w-7xl mx-auto">
            <div class="text-center space-y-6 p-4 sm:p-6 mb-8">
                <%- include("../partials/heading") %>
                
                <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300">
                    Discover your perfect stay or host your home with ease.
                </p>
                
                <a href="/host/add-home" 
                    class="inline-block w-full sm:w-auto text-center text-base sm:text-lg font-semibold text-white bg-sky-500 hover:bg-sky-600 hover:underline py-3 px-5 rounded-lg shadow-lg transition">
                    Add Home
                </a>
            </div>

            <!-- Responsive Grid Layout for Homes -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
                <% homes.forEach(home => { %>
                    <div class="bg-white dark:bg-zinc-700 rounded-lg shadow-md text-left overflow-hidden flex flex-col">
                        <!-- Image Container with responsive aspect ratio and favorite form -->
                        <div class="relative">
                            <div class="pt-[56.25%]">
                                <img 
                                    src="<%= home.picUrl %>" 
                                    alt="<%= home.houseName %>"
                                    class="absolute top-0 left-0 w-full h-full object-cover"
                                >
                            </div>
                            <!-- Favorite Button -->
                            <%- include("../partials/addToFav", {home: home}) %>
                        </div>
                        <!-- Content Container -->
                        <div class="p-4 flex-1 flex flex-col">
                            <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white mb-2 line-clamp-2">
                                <%= home.houseName %>
                            </h3>
                            <div class="space-y-2 text-gray-600 dark:text-gray-300 flex-1">
                                <p class="flex items-center justify-between">
                                    <span class="text-sky-500 font-medium">&#8377 <%= home.price %>/night</span>
                                    <span class="flex items-center">
                                        <svg class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                        <%= home.rating %>
                                    </span>
                                </p>
                                <p class="flex items-center text-sm">
                                    <svg class="w-4 h-4 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                    <span class="truncate"><%= home.location %></span>
                                </p>
                                <!-- Detail Button -->
                                <div class="mt-4">
                                    <a href="/homes/<%= home.id %>" 
                                       class="w-full inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-sky-500 hover:bg-sky-600 rounded-lg shadow transition-colors duration-200">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        View Details
                                    </a>                                    
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</body>
</html>

