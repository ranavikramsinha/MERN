<%- include("../partials/head") %>
</head>
<body class="bg-white dark:bg-zinc-900 text-black dark:text-white min-h-screen">
    <%- include("../partials/nav") %>



    <div class="pt-20 px-4 md:px-6 lg:px-8 max-w-7xl mx-auto pb-12">
        
            <%- include("../partials/homeDetailTitle") %>
            

        <% if (typeof home !== 'undefined' && home) { %>
            <!-- Property Overview -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Image Section -->
                <div class="space-y-4">
                    <div class="relative">
                        <div class="aspect-w-16 aspect-h-9 w-full">
                            <img 
                                src="<%= home.picUrl %>" 
                                alt="<%= home.houseName %>"
                                class="w-full h-96 object-cover rounded-lg shadow-lg"
                            >
                        </div>
                        <!-- Favorite Button -->
                        <%- include("../partials/addToFav", {home: home}) %>

                    </div>
                </div>

                <!-- Details Section -->
                <div class="space-y-6">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
                            <%= home.houseName %>
                        </h1>
                        <p class="mt-2 text-base md:text-lg text-gray-600 dark:text-gray-300 flex items-center">
                            <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            <span class="truncate"><%= home.location %></span>
                        </p>
                    </div>

                    <div class="flex items-center justify-between border-b border-gray-200 dark:border-gray-700 pb-4">
                        <span class="text-xl md:text-2xl font-bold text-sky-500">&#8377 <%= home.price %>/night</span>
                        <span class="flex items-center text-base md:text-lg">
                            <svg class="w-5 h-5 md:w-6 md:h-6 text-yellow-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            <%= home.rating %> Rating
                        </span>
                    </div>

                    <!-- Property Features -->
                    <div class="space-y-4">
                        <h2 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-white">Property Features</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <% if (home.features) { %>
                                <% home.features.forEach(feature => { %>
                                    <div class="flex items-center text-gray-600 dark:text-gray-300">
                                        <svg class="w-5 h-5 mr-2 text-sky-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        <span class="truncate"><%= feature %></span>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>

                    <!-- Property Description -->
                    <div class="space-y-4">
                        <h2 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-white">Description</h2>
                        <p class="text-gray-600 dark:text-gray-300 text-base">
                            <%= home.description %>
                        </p>
                    </div>

                    <!-- Host Information -->
                    <div class="space-y-4">
                        <h2 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-white">Host Information</h2>
                        <div class="flex items-center space-x-4">
                            <% if (home.host && home.host.profilePic) { %>
                                <img src="<%= home.host.profilePic %>" alt="Host" class="w-10 h-10 md:w-12 md:h-12 rounded-full">
                            <% } %>
                            <div>
                                <p class="font-medium text-gray-900 dark:text-white"><%= home.host ? home.host.name : 'Host Name' %></p>
                                <p class="text-sm md:text-base text-gray-600 dark:text-gray-300">Member since <%= home.host ? home.host.joinedDate : 'Date' %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Button -->
                    <div class="mt-8">
                        <a href="/homes/<%= home.id %>/book" 
                           class="block w-full text-center text-base md:text-lg font-semibold text-white bg-sky-500 hover:bg-sky-600 py-3 md:py-4 rounded-lg shadow-lg transition">
                            Book Now
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <p class="text-gray-600 dark:text-gray-300">Property details are not available.</p>
                <a href="/homes" class="mt-4 inline-block text-sky-500 hover:underline">Back to Homes</a>
            </div>
        <% } %>
    </div>


</body>
</html>